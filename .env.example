# Telegram bot token from @BotFather. NEVER commit the real value.
BOT_TOKEN=

# SQLAlchemy database URL. Defaults to a local SQLite file if left empty.
# Dev (SQLite):    sqlite+aiosqlite:///./safabot.db
# Prod (Postgres): postgresql+asyncpg://user:password@host:5432/safabot
DATABASE_URL=sqlite+aiosqlite:///./safabot.db

# Logging verbosity: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Fallback timezone used until a user sets their own (IANA name, e.g. Europe/Moscow)
DEFAULT_TIMEZONE=UTC

# Length of the free trial granted on registration (section 24)
TRIAL_DAYS=7

# Default onboarding values (section 10 / 23)
DEFAULT_DAILY_NEW_WORDS=4

# Max overdue reviews queued into one learning session (learning-core stage, section 8)
MAX_DAILY_REVIEWS=30
DEFAULT_MORNING_TIME=09:00
DEFAULT_AFTERNOON_TIME=14:00
DEFAULT_EVENING_TIME=20:00

# Vercel AI Gateway (https://vercel.com/docs/ai-gateway) - the
# HIGHEST-priority text provider when configured, ahead of both direct
# Gemini and DeepSeek below. An OpenAI-Chat-Completions-compatible
# endpoint that routes to Gemini (and other providers) from Vercel's own
# infrastructure - useful when this server's own region can't reach
# Gemini directly ("User location is not supported for the API use").
# Reuses the same OpenAI-compatible transport already used for DeepSeek -
# no separate provider code. Get a key at vercel.com/ai-gateway (no code
# deploy needed, just an API key from the dashboard). Leave empty to skip
# straight to GEMINI_API_KEY/AI_API_KEY below - identical behavior to
# every release before this existed.
# NEVER put a real key here or in any committed file - only in your local .env.
AI_GATEWAY_API_KEY=
# google/<model> naming (Vercel's own catalog convention). The full
# current list is public, unauthenticated: curl https://ai-gateway.vercel.sh/v1/models
AI_GATEWAY_MODEL=google/gemini-2.5-flash
# Override only for a non-default Gateway endpoint (rare).
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
AI_GATEWAY_ENABLED=true

# Google Gemini (services/gemini_provider.py) - the direct-connection
# provider, tried after Vercel AI Gateway (if configured) and before
# DeepSeek. Everything below (AI_PROVIDER/AI_API_KEY/AI_MODEL, "DeepSeek"
# by default) becomes the FINAL fallback for text-only tasks instead of
# disappearing: each configured provider is tried in order, and only on a
# timeout/network error/rate limit/quota error/unavailability/invalid
# response does a text request fall through to the next one - the very
# next request starts back at the top of the chain again. Leave
# GEMINI_API_KEY empty to skip straight to AI_API_KEY (or fully on the
# local dictionary/word pool if that's empty too) - identical behavior to
# every release before this integration existed.
# NEVER put a real key here or in any committed file - only in your local .env.
GEMINI_API_KEY=
# "-latest" aliases (per Gemini's own docs) always point at the newest
# release of that model family, so this stays "the current model" across
# Gemini releases without editing config - pin an exact version (e.g.
# gemini-2.5-flash) instead if you need stability across silent upgrades.
GEMINI_MODEL=gemini-flash-latest
# Optional per-capability overrides - leave empty to use GEMINI_MODEL for
# everything (text, image, and audio all go through the same Gemini call
# shape, so one model covers all three unless you have a reason to split).
GEMINI_TEXT_MODEL=
GEMINI_MULTIMODAL_MODEL=
# Override only for a non-default Gemini endpoint (rare). Leave empty to
# use https://generativelanguage.googleapis.com.
GEMINI_BASE_URL=
GEMINI_ENABLED=true
# Some regions get HTTP 400 "User location is not supported for the API
# use" from Google, regardless of key validity. Set this to a forward
# proxy URL (e.g. http://user:pass@host:port) in a supported region to
# route ONLY Gemini's own requests through it - DeepSeek/Telegram traffic
# (their own separate HTTP clients) is never affected.
# Leave empty if Gemini is reachable directly from this server.
GEMINI_PROXY_URL=

# AI integration (services/ai_service.py) - the FALLBACK provider for
# text-only tasks once GEMINI_API_KEY is set (see above), or the only
# provider if it isn't. Leave AI_API_KEY empty too to run fully on the
# local dictionary/word pool - the bot starts and works fine without it,
# AI-backed features just report "AI-функции пока не настроены."
# AI_PROVIDER is a human-readable label only (used in logs/WordGenerationLog).
AI_PROVIDER=deepseek
# NEVER put a real key here or in any committed file - only in your local .env.
AI_API_KEY=
# Model name for your provider, e.g. deepseek-chat, gpt-4o-mini, gpt-4o.
AI_MODEL=deepseek-chat
# Override only if you're pointing at a non-OpenAI, OpenAI-compatible
# endpoint (Azure OpenAI, OpenRouter, a self-hosted gateway, etc).
# Leave empty to use https://api.openai.com/v1.
AI_BASE_URL=
# Master switch - set to false to force the bot onto the local database
# only, even if AI_API_KEY is set (useful for offline development).
AI_ENABLED=true
# Per-request network timeout, in seconds.
AI_TIMEOUT_SECONDS=30
# Retries for transient errors (timeout/network/5xx) - never retried on
# 401/403 (bad key). 0 disables retries.
MAX_AI_RETRIES=2
# Simple per-user rate limits enforced in-process before any AI call.
AI_REQUESTS_PER_MINUTE=5
AI_REQUESTS_PER_DAY=200
# How many times services/word_generation_service.py may re-ask the AI for
# more words if earlier ones turned out to be duplicates (never unbounded).
MAX_GENERATION_ATTEMPTS=3
# Separate daily pool for "➕ Ещё новые слова" (bugfix stage) - independent
# of daily_new_words, so an eager user can ask for more today without
# raising everyone's default pace, and DeepSeek usage stays bounded.
MAX_EXTRA_WORDS_PER_DAY=20

# Cost control (bugfix stage section 22): a cap on what gets sent to AI
# providers, regardless of what a user pastes.
MAX_TEXT_LENGTH=2000
